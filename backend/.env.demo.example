# Demo / end-to-end profile (PRD NFR-R6). Copy to .env.demo, fill the blanks, then load it over .env:
#   cp .env.demo.example .env.demo
#   set -a && source .env.demo && set +a && .venv/bin/python -m uvicorn app.main:app
# Environment variables override backend/.env, so your normal settings stay untouched.
# Development only: demo-header auth is refused when ENVIRONMENT is not "development".
ENVIRONMENT=development
ALLOW_DEMO_AUTH=true
# A disposable database. Seed the demo user with:
#   .venv/bin/python seed_demo.py --user-id user_demo_priya
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifeos_demo
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8000
# Leave every LLM key empty to demo graceful degradation (quick add), or set one provider:
LLM_PROVIDER=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Web Push for the live reminder on a phone (generate with `vapid --gen`):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
# Load tests use many demo users; keep the per-user limits at the PRD values unless you share one user.
CHAT_RATE_LIMIT=30
API_RATE_LIMIT=300
WORKER_POLL_SECONDS=30
