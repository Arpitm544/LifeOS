ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifeos
# Local PostgreSQL only; keep true for hosted databases.
DATABASE_SSL=false
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
ALLOW_DEMO_AUTH=false
# Chat model: set the key for ANY ONE provider. If several are set, LLM_PROVIDER picks one
# (groq, xai/grok, openai, gemini, openrouter, anthropic, custom); otherwise the first key found wins in that order.
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
XAI_API_KEY=
XAI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
# Any other OpenAI-compatible endpoint (needs all three; base URL like https://host/v1):
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
CHAT_RATE_LIMIT=30
API_RATE_LIMIT=300
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_INSIGHT_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=8
# Browser origins of the Next.js app allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Web Push (generate once: `vapid --gen` from py-vapid, or any VAPID tool).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Browser push services subscriptions may point to (comma-separated host suffixes).
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,notify.windows.com,push.apple.com
# Worker: administrative connection (reads due reminders for every user).
# Leave empty to reuse DATABASE_URL in local development.
WORKER_DATABASE_URL=
WORKER_POLL_SECONDS=30
